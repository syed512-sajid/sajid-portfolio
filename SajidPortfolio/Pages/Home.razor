<!-- PROJECT MODAL -->
@if (openProjectIndex is not null)
{
    var project = Projects[openProjectIndex.Value];

    <div class="modal-overlay"
         @onclick="CloseProject">

        <div class="modal-panel"
             role="dialog"
             aria-modal="true"
             @onclick:stopPropagation="true">

            <button class="modal-close"
                    @onclick="CloseProject"
                    aria-label="Close">
                ✕
            </button>


            <!-- MODAL IMAGE -->
            <div class="modal-image-wrap">

                <img class="modal-thumb"
                     src="images/projects/@project.ImageFile"
                     alt="@project.Name screenshot"
                     onerror="this.onerror=null;this.src='images/projects/placeholder.png';" />

                <!-- MODAL EYE -->
                <a class="image-preview-btn modal-image-preview"
                   href="images/projects/@project.ImageFile"
                   target="_blank"
                   rel="noopener"
                   title="Open image in new tab"
                   aria-label="Open image in new tab"
                   @onclick:stopPropagation="true">

                    <span class="eye-icon">👁</span>

                </a>

            </div>


            <p class="modal-eyebrow">
                @project.Category
            </p>


            <h2>
                @project.Name
            </h2>


            <div class="modal-section">

                <h4>
                    Overview
                </h4>

                <p>
                    @project.Overview
                </p>

            </div>


            <div class="modal-section">

                <h4>
                    My role
                </h4>

                <p>
                    @project.Role
                </p>

            </div>


            <div class="modal-section">

                <h4>
                    Highlights
                </h4>

                <ul class="modal-points">

                    @foreach (var point in project.Highlights)
                    {
                        <li>
                            @point
                        </li>
                    }

                </ul>

            </div>


            <div class="modal-section">

                <h4>
                    Built with
                </h4>

                <div class="tags">

                    @foreach (var tag in project.Tags)
                    {
                        <span class="tag">
                            @tag
                        </span>
                    }

                </div>

            </div>

        </div>

    </div>
}


@code {


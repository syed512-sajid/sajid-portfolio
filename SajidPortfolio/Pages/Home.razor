<main class="content">

    <!-- HOME -->
    <section id="home" class="section hero">
        <div class="split">
            <div>
                <p class="eyebrow">Full Stack .NET Developer — VasTek Solution, Lahore</p>
                <h1 class="hero-title">I build reliable business software with .NET, end to end.</h1>
                <p class="hero-sub">
                    I'm Sajid Abbas, based in Multan, Pakistan. I design and build ASP.NET Core
                    services, SQL Server data layers, and desktop tools for real businesses —
                    focused on clean architecture, correct data, and code the next developer
                    can actually read.
                </p>

                <div class="hero-cta">
                    <a href="#projects" class="btn btn-primary">View projects</a>
                    <a href="resume/Sajid-Abbas-Resume.pdf" download="Sajid-Abbas-Resume.pdf" class="btn btn-ghost btn-icon">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 3v12" />
                            <path d="M7 10l5 5 5-5" />
                            <path d="M5 21h14" />
                        </svg>
                        Download resume
                    </a>
                    <a href="contact" target="_blank" rel="noopener" class="btn btn-ghost">Get in touch</a>
                </div>

                <dl class="hero-stats">
                    <div><dt>3+ yr</dt><dd>professional experience</dd></div>
                    <div><dt>@ProjectData.Projects.Count</dt><dd>shipped projects</dd></div>
                    <div><dt>2</dt><dd>companies worked with</dd></div>
                </dl>
            </div>

            <div class="side-panel">
                <h3>At a glance</h3>
                <dl class="facts-list">
                    <dt>Location</dt>
                    <dd>Multan, Pakistan</dd>
                    <dt>Current role</dt>
                    <dd>Full Stack .NET Developer, VasTek Solution</dd>
                    <dt>Core stack</dt>
                    <dd>ASP.NET Core &amp; SQL Server</dd>
                    <dt>Open to</dt>
                    <dd>Full-time roles &amp; freelance projects</dd>
                </dl>
            </div>
        </div>
    </section>


    <!-- ABOUT -->
    <section id="about" class="section">
        <div class="split">
            <div>
                <p class="eyebrow">About</p>
                <h2 class="section-title">A developer who cares about the boring parts.</h2>
                <p class="body-text">
                    I'm a dedicated .NET Developer with over one year of experience building
                    and maintaining scalable web applications. I specialize in back-end
                    systems using .NET and SQL Server / MySQL, with a close focus on data
                    integrity and application performance.
                </p>
                <p class="body-text">
                    I'm organised, reliable, and comfortable adapting when requirements
                    change mid-project. I work well independently and inside a team, and I'd
                    rather ship something maintainable than something merely fast.
                </p>
            </div>

            <div class="side-panel">
                <h3>Focus areas</h3>
                <ul class="interest-list">
                    <li>Open-source collaboration</li>
                    <li>Mentoring &amp; helping others</li>
                    <li>Self-improvement</li>
                    <li>Applied science</li>
                    <li>Entrepreneurship</li>
                    <li>Cryptocurrency</li>
                    <li>Games</li>
                </ul>
            </div>
        </div>
    </section>


    <!-- EXPERIENCE -->
    <section id="experience" class="section">
        <p class="eyebrow">Experience</p>
        <h2 class="section-title">Work history</h2>

        <div class="timeline">
            <article class="timeline-item">
                <div class="timeline-marker"></div>
                <div class="timeline-body">
                    <div class="timeline-head">
                        <h3>Full Stack Dot Net Developer</h3>
                        <span class="timeline-date">Feb 2025 — Present</span>
                    </div>
                    <p class="timeline-org">VasTek Solution · Gulberg, Lahore</p>
                    <ul class="timeline-points">
                        <li>Developing and maintaining desktop and web applications with .NET Core, WinForms and ASP.NET for evolving client needs.</li>
                        <li>Building responsive interfaces with Bootstrap, HTML5, JavaScript and jQuery.</li>
                        <li>Implementing and optimising data storage and retrieval in SQL Server.</li>
                        <li>Troubleshooting and debugging across application layers for reliability.</li>
                    </ul>
                </div>
            </article>

            <article class="timeline-item">
                <div class="timeline-marker"></div>
                <div class="timeline-body">
                    <div class="timeline-head">
                        <h3>Full Stack Dot Net Developer</h3>
                        <span class="timeline-date">Oct 2023 — Jan 2025</span>
                    </div>
                    <p class="timeline-org">Siriz Apps · Johar Town, Lahore</p>
                    <ul class="timeline-points">
                        <li>Developed desktop and web applications using .NET Core, WinForms and ASP.NET, improving system functionality and performance.</li>
                        <li>Built responsive, interactive UIs with Bootstrap, JavaScript, HTML5 and jQuery.</li>
                        <li>Managed backend data operations in SQL Server, including stored procedures and query optimisation.</li>
                        <li>Designed and refined application workflows across desktop and web modules.</li>
                    </ul>
                </div>
            </article>
        </div>
    </section>


    <!-- SKILLS -->
    <section id="skills" class="section">
        <p class="eyebrow">Skills</p>
        <h2 class="section-title">Toolbox</h2>

        <div class="skills-grid">
            <div class="skill-group">
                <h3>Languages &amp; Frameworks</h3>
                <div class="tags">
                    <span class="tag">C#</span><span class="tag">ASP.NET Core</span><span class="tag">ASP.NET Framework</span>
                    <span class="tag">ASP.NET Core MVC</span><span class="tag">Angular</span><span class="tag">JavaScript</span><span class="tag">jQuery</span>
                </div>
            </div>
            <div class="skill-group">
                <h3>Desktop</h3>
                <div class="tags"><span class="tag">WinForms</span><span class="tag">BackgroundWorker</span><span class="tag">HttpClient</span></div>
            </div>
            <div class="skill-group">
                <h3>Data &amp; Backend</h3>
                <div class="tags"><span class="tag">SQL Server</span><span class="tag">MySQL</span><span class="tag">AJAX</span><span class="tag">Stored Procedures</span></div>
            </div>
            <div class="skill-group">
                <h3>Architecture &amp; Patterns</h3>
                <div class="tags">
                    <span class="tag">Repository Pattern</span><span class="tag">Service Layer</span>
                    <span class="tag">Layered / Clean Architecture</span><span class="tag">Dependency Injection</span>
                </div>
            </div>
            <div class="skill-group">
                <h3>Auth &amp; Security</h3>
                <div class="tags"><span class="tag">Cookie Authentication</span><span class="tag">Custom Middleware</span><span class="tag">Role-based Access</span></div>
            </div>
            <div class="skill-group">
                <h3>Background Processing</h3>
                <div class="tags"><span class="tag">Hosted Services</span><span class="tag">Scheduled Jobs</span></div>
            </div>
            <div class="skill-group">
                <h3>Frontend</h3>
                <div class="tags"><span class="tag">HTML</span><span class="tag">CSS</span><span class="tag">Bootstrap</span></div>
            </div>
            <div class="skill-group">
                <h3>Working style</h3>
                <div class="tags"><span class="tag">Problem Solving</span><span class="tag">Communication</span><span class="tag">Time Management</span></div>
            </div>
        </div>
    </section>


    <!-- PROJECTS -->
    <section id="projects" class="section">
        <p class="eyebrow">Projects</p>
        <h2 class="section-title">Selected work</h2>
        <p class="body-text">Click any project to see the full write-up.</p>

        <div class="project-grid">
            @foreach (var project in ProjectData.Projects)
            {
                <a class="project-card" href="@($"/project/{project.Id}")">
                    <div class="project-image-wrap">
                        <img class="project-thumb"
                             src="images/projects/@project.ImageFiles[0]"
                             alt="@project.Name screenshot"
                             onerror="this.onerror=null;this.src='images/projects/placeholder.png';" />

                        @if (project.ImageFiles.Count > 1)
                        {
                            <span class="image-count-badge">📷 @project.ImageFiles.Count</span>
                        }

                        <!-- --new: sirf visual icon, no onclick — parent <a> khud navigate karega -->
                        <span class="image-preview-btn" aria-hidden="true">
                            <span class="eye-icon">👁</span>
                        </span>
                    </div>

                    <div class="project-card-body">
                        <h3>@project.Name</h3>
                        <p>@project.Summary</p>
                        <div class="tags">
                            @foreach (var tag in project.Tags)
                            {
                                <span class="tag">@tag</span>
                            }
                        </div>
                        <span class="view-details">View details →</span>
                    </div>
                </a>
            }
        </div>
    </section>


    <!-- EDUCATION -->
    <section id="education" class="section">
        <p class="eyebrow">Education</p>
        <h2 class="section-title">Education &amp; certification</h2>

        <div class="edu-block">
            <div class="edu-head">
                <h3>BS, Information Technology</h3>
                <span class="timeline-date">Oct 2019 — Jun 2023</span>
            </div>
            <p class="timeline-org">Muhammad Nawaz Sharif University of Agriculture, Multan · GPA 3.1</p>
        </div>

        <div class="edu-block">
            <div class="edu-head">
                <h3>Responsive Web Design — Certificate</h3>
                <span class="timeline-date">March 2024</span>
            </div>
        </div>
    </section>


    <!-- CONTACT -->
    <section id="contact" class="section contact-section">
        <p class="eyebrow">Contact</p>
        <h2 class="section-title">Let's work together.</h2>
        <p class="body-text">
            Open to full-time roles, freelance projects, and anything in between that
            needs a dependable .NET developer.
        </p>

        <div class="contact-grid">
            <a href="mailto:sajidabbas6024@@gmail.com" class="contact-card">
                <span class="contact-label">Email</span>
                <span class="contact-value">sajidabbas6024@@gmail.com</span>
            </a>
            <a href="tel:+923099696024" class="contact-card">
                <span class="contact-label">Phone</span>
                <span class="contact-value">+92 309 9696024</span>
            </a>
            <a href="https://www.linkedin.com/in/sajidabbas6024" target="_blank" rel="noopener" class="contact-card">
                <span class="contact-label">LinkedIn</span>
                <span class="contact-value">in/sajidabbas6024</span>
            </a>
            <a href="https://github.com/syed512-sajid" target="_blank" rel="noopener" class="contact-card">
                <span class="contact-label">GitHub</span>
                <span class="contact-value">syed512-sajid</span>
            </a>
            <a href="resume/Sajid-Abbas-Resume.pdf" download="Sajid-Abbas-Resume.pdf" class="contact-card">
                <span class="contact-label">Resume</span>
                <span class="contact-value">Download PDF</span>
            </a>
            <div class="contact-card contact-card-static">
                <span class="contact-label">Location</span>
                <span class="contact-value">Multan, Pakistan</span>
            </div>
            <a href="contact" class="contact-card">
                <span class="contact-label">Message</span>
                <span class="contact-value">Contact via Form</span>
            </a>
        </div>

        <footer class="footer">
            <span>© <span id="year"></span> Sajid Abbas. Built with Blazor WebAssembly.</span>
        </footer>
    </section>

</main>


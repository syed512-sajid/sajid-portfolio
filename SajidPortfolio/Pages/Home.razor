    <!-- PROJECTS -->
    <section id="projects" class="section">

        <p class="eyebrow">Projects</p>

        <h2 class="section-title">
            Selected work
        </h2>

        <p class="body-text">
            Click any project to see the full write-up.
        </p>


        <div class="project-grid">

            @for (int i = 0; i < Projects.Count; i++)
            {
                var index = i;
                var project = Projects[index];

                <div class="project-card"
                     tabindex="0"
                     role="button"
                     aria-haspopup="dialog"
                     @onclick="() => OpenProject(index)"
                     @onkeydown="(e) => OnCardKeyDown(e, index)">

                    <!-- IMAGE -->
                    <div class="project-image-wrap">

                        <img class="project-thumb"
                             src="images/projects/@project.ImageFile"
                             alt="@project.Name screenshot"
                             onerror="this.onerror=null;this.src='images/projects/placeholder.png';" />

                        <!-- EYE BUTTON -->
                        <a class="image-preview-btn"
                           href="images/projects/@project.ImageFile"
                           target="_blank"
                           rel="noopener"
                           title="Open image in new tab"
                           aria-label="Open @project.Name image in new tab"
                           @onclick:stopPropagation="true">

                            <span class="eye-icon">👁</span>

                        </a>

                    </div>


                    <!-- PROJECT CONTENT -->
                    <div class="project-card-body">

                        <h3>
                            @project.Name
                        </h3>

                        <p>
                            @project.Summary
                        </p>

                        <div class="tags">

                            @foreach (var tag in project.Tags)

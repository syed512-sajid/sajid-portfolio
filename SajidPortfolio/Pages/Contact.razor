@page "/contact"
@using Microsoft.AspNetCore.Components.Forms
@inject IJSRuntime JS

<PageTitle>Contact — Sajid Abbas</PageTitle>

<div class="contact-page">

    <div class="contact-form-card">

        <p class="eyebrow">Contact</p>
        <h1 class="section-title">Send me a message</h1>
        <p class="body-text">
            Fill this in — it goes straight to my inbox, no email app needed.
        </p>

        <EditForm Model="model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary class="form-validation-summary" />

            <div class="form-group">
                <label for="name">Name</label>
                <InputText id="name" class="form-input" @bind-Value="model.Name" placeholder="Your name" />
                <ValidationMessage For="@(() => model.Name)" class="field-error" />
            </div>

            <div class="form-group">
                <label for="email">Your email</label>
                <InputText id="email" class="form-input" @bind-Value="model.Email" placeholder="you@example.com" />
                <ValidationMessage For="@(() => model.Email)" class="field-error" />
            </div>

            <div class="form-group">
                <label for="subject">Subject</label>
                <InputText id="subject" class="form-input" @bind-Value="model.Subject" placeholder="What's this about?" />
            </div>

            <div class="form-group">
                <label for="message">Message</label>
                <InputTextArea id="message" class="form-input form-textarea" rows="6" @bind-Value="model.Message" placeholder="Your message..." />
                <ValidationMessage For="@(() => model.Message)" class="field-error" />
            </div>

            <button type="submit" class="btn btn-primary" disabled="@isSending">
                @if (isSending)
                {
                    <span class="btn-spinner"></span>
                    <span>Sending...</span>
                }
                else
                {
                    <span>Send message</span>
                }
            </button>

            @if (!string.IsNullOrEmpty(statusMessage) && isError)
            {
                <p class="form-status form-status-error">
                    @statusMessage
                </p>
            }
        </EditForm>
        @if (isSending)
        {
            <div class="page-loader-overlay">
                <div class="page-loader-box">
                    <div class="page-spinner"></div>
                    <h4>Sending email...</h4>
                    <p>Please wait while your message is being sent.</p>
                </div>
            </div>
        }
        @if (showSuccessModal)
        {
            <div class="success-modal-overlay">
                <div class="success-modal">

                    <div class="success-check">
                        ✓
                    </div>

                    <h3>Email Sent Successfully!</h3>

                    <p>
                        Your message has been sent successfully.
                        I'll get back to you soon.
                    </p>

                    <button type="button"
                            class="btn btn-primary success-close-btn"
                            @onclick="CloseSuccessModal">
                        OK
                    </button>

                </div>
            </div>
        }
    </div>

</div>


@code {
    private bool showSuccessModal = false;
    private ContactModel model = new();
    private bool isSending = false;
    private bool isError = false;
    private string statusMessage = "";

    private async Task HandleSubmit()
    {
        isSending = true;
        statusMessage = "";
        isError = false;
        showSuccessModal = false;

        try
        {
            var result = await JS.InvokeAsync<bool>(
                "sendContactEmail",
                model.Name,
                model.Email,
                string.IsNullOrWhiteSpace(model.Subject)
                    ? "Portfolio contact form"
                    : model.Subject,
                model.Message);

            if (result)
            {
                // Email successfully sent
                model = new ContactModel();

                // Show success modal
                showSuccessModal = true;
            }
            else
            {
                statusMessage = "Something went wrong. Please try again or email me directly.";
                isError = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);

            statusMessage = "Something went wrong. Please try again or email me directly.";
            isError = true;
        }
        finally
        {
            isSending = false;
        }
    }

    private void CloseSuccessModal()
    {
        showSuccessModal = false;
    }

    public class ContactModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Name is required")]
        public string Name { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Email is required")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Enter a valid email")]
        public string Email { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Subject is required")]
        public string Subject { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Message is required")]
        public string Message { get; set; } = "";
    }
}

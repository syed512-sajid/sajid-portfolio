    <!-- Bouncing arrow -->
    <div class="fab-arrow" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 9l6 6 6-6" />
        </svg>
    </div>

    <!-- WhatsApp -->
    <a class="fab-btn fab-whatsapp"
       href="https://wa.me/923099696024?text=Hi%20Sajid%2C%20I%20came%20across%20your%20portfolio%20and%20would%20like%20to%20discuss%20a%20potential%20opportunity%2Fproject%20with%20you."
       target="_blank"
       rel="noopener"
       aria-label="Chat on WhatsApp"
       title="Chat on WhatsApp">
        <svg viewBox="0 0 32 32" width="28" height="28" fill="white" xmlns="http://www.w3.org/2000/svg">
            <path d="M16.001 3C9.373 3 4 8.373 4 15c0 2.386.7 4.607 1.902 6.475L4 29l7.72-1.868A11.93 11.93 0 0 0 16.001 27C22.629 27 28 21.627 28 15S22.629 3 16.001 3zm0 21.75c-1.99 0-3.86-.55-5.46-1.51l-.39-.23-4.58 1.11 1.13-4.47-.25-.4A9.7 9.7 0 0 1 5.25 15c0-5.93 4.82-10.75 10.75-10.75S26.75 9.07 26.75 15 21.93 24.75 16.001 24.75z" />
            <path d="M21.62 17.83c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.47-.89-.79-1.48-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.53.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.5-.17-.01-.37-.01-.57-.01s-.52.07-.8.37c-.27.3-1.04 1.02-1.04 2.48s1.07 2.87 1.22 3.07c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.08 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35z" />
        </svg>
    </a>

</div>

@code {
    private bool showSuccessModal = false;
    private ContactModel model = new();
    private bool isSending = false;
    private bool isError = false;
    private string statusMessage = "";
   
    private async Task HandleSubmit()
    {
        isSending = true;
        statusMessage = "";
        isError = false;
        showSuccessModal = false;

        try
        {
            var result = await JS.InvokeAsync<bool>(
                "sendContactEmail",
                model.Name,
                model.Email,
                string.IsNullOrWhiteSpace(model.Subject)
                    ? "Portfolio contact form"
                    : model.Subject,
                model.Message);

            if (result)
            {
                // Email successfully sent
                model = new ContactModel();

                // Show success modal
                showSuccessModal = true;
            }
            else
            {
                statusMessage = "Something went wrong. Please try again or email me directly.";
                isError = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);

            statusMessage = "Something went wrong. Please try again or email me directly.";
            isError = true;
        }
        finally
        {
            isSending = false;
        }
    }
